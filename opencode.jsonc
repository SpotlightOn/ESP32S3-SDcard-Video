{
  "$schema": "https://opencode.ai/config.json",

  // config.h in the project root holds the local WiFi credentials and the
  // weather API key. It is git-ignored and must stay private: only the tracked
  // template config.h.example may be read or edited by an agent.
  // Rules are matched in order, the last match wins.
  "permissions": [
    { "action": "read", "resource": "config.h", "effect": "deny" },
    { "action": "edit", "resource": "config.h", "effect": "deny" },

    // Shell commands are raw text, so block every command that mentions the
    // file. This also stops `cat`, `grep`, `cp` and `git add` from touching it.
    { "action": "shell", "resource": "*config.h*", "effect": "deny" },
  ],
}
